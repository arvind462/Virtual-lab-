   "source": [
    "import matplotlib.pyplot as plt\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.xlabel('Mass →')\n",
    "plt.ylabel('Radius →')\n",
    "plt.fill_between([0.2, 0.8], [0.2, 0.2], [0.8, 0.8], color='grey', alpha=0.3, label='Smooth EOS')\n",
    "plt.plot([0.2, 0.5], [0.3, 0.7], 'b-', lw=2, label='FOPT (low ε_tr)')\n",
    "plt.plot([0.2, 0.5], [0.2, 0.6], 'r-', lw=2, label='FOPT (high ε_tr)')\n",
    "plt.scatter(0.5, 0.7, color='k', s=100, label=r'$M_c$ (convergence)')\n",
    "plt.legend()\n",
    "plt.title('Mass-Radius Diagram')\n",
    "plt.show()"
   ]
